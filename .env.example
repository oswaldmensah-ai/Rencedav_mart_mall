# ─── Core Django ───────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-very-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ──────────────────────────────────────────────────────────────────
DB_NAME=rencedav_mart
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ─── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# ─── Site ──────────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:8000
SITE_NAME=Rencedav Mart & More

# ─── Google sign-in ────────────────────────────────────────────────────────────
# Create OAuth credentials in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (optional for dev) ──────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@rencedavmart.com

# ─── Production only ───────────────────────────────────────────────────────────
## Set these on the hosting provider, not in a committed .env file.
# DJANGO_SETTINGS_MODULE=config.settings.production
# SECRET_KEY=generate-a-new-random-secret-at-least-50-characters-long
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# ALLOWED_HOSTS=your-service.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
# SITE_URL=https://your-service.onrender.com
# DEFAULT_FROM_EMAIL=noreply@your-domain.com
# PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
